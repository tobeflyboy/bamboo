    <!-- 构建配置 -->
    <!-- 配置项目的构建过程和插件 -->
    <build>
        <!-- 插件版本管理 -->
        <!-- 统一管理项目中使用的Maven插件版本 -->
        <pluginManagement>
            <plugins>
                <!-- Spring Boot Maven插件 -->
                <!-- 主要作用：
                     1. 将普通jar重新打包为可直接运行的Spring Boot可执行jar
                     2. 在构建时生成应用构建信息（如版本号、构建时间、Git信息等）
                -->
                <plugin>
                    <!-- Spring Boot官方插件坐标 -->
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <!-- 插件版本，通常与Spring Boot版本保持一致 -->
                    <version>${springboot.version}</version>
                    <!-- 插件执行配置：定义在Maven构建生命周期的哪个阶段执行哪些目标 -->
                    <executions>
                        <!-- repackage目标：
                             - 默认绑定在package阶段
                             - 将Maven打出来的普通jar转换为包含内置Tomcat/Jetty的可执行Spring Boot jar
                             - 生成的jar可以通过：java -jar xxx.jar 直接运行
                        -->
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                        <!-- build-info目标：
                             - 用于生成META-INF/build-info.properties文件
                             - 该文件会被Spring Boot自动读取
                             - 可通过/actuator/info或BuildProperties在代码中访问
                             使用场景：
                               - 查看应用版本
                               - 查看构建时间
                               - CI/CD版本追踪
                        -->
                        <execution>
                            <id>build-info</id>
                            <!-- 指定在资源处理阶段执行，确保打包前生成构建信息 -->
                            <phase>process-resources</phase>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Maven部署插件 -->
                <!-- 主要作用：
                     - 控制是否将构建产物（jar/pom）上传到远程仓库（如Nexus、私服）
                    当前配置说明：
                     - skip = true 表示"完全跳过部署"
                     - 适用于：
                         * 本地开发
                         * 测试环境
                         * 非正式发布构建
                     - 可防止误将测试包发布到正式仓库
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                    <configuration>
                        <!-- 跳过deploy阶段，不上传构建产物到远程仓库 -->
                        <skip>true</skip>
                    </configuration>
                </plugin>

                <!-- Maven编译插件 -->
                <!-- 主要作用：
                     - 控制Java源码的编译行为
                     - 统一JDK版本
                     - 传递额外的javac编译参数
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <!-- 支持JDK 21的稳定版本 -->
                    <version>3.15.0</version>
                    <configuration>
                        <!-- 使用-release统一指定Java版本（推荐方式，JDK 9+）
                             等价于同时设置：
                               - source：源码语法级别
                               - target：生成的字节码版本
                               - bootclasspath：对应JDK的标准库API
                             优点：
                               - 防止误用高版本JDK API
                               - 避免运行时不兼容问题
                        -->
                        <release>${java.version}</release>
                        <!-- 传递给javac的额外编译参数
                             每一个<arg>都是一个独立的编译参数
                        -->
                        <compilerArgs>
                            <!-- -parameters参数：
                                 作用：在编译后的.class文件中保留方法参数的真实名称
                                 使用场景：
                                   - Spring MVC参数绑定
                                   - AOP/反射
                                   - Jackson/MapStruct等框架
                                 不加该参数时，参数名会变成arg0/arg1
                            -->
                            <arg>-parameters</arg>
                            <!-- -Xlint:-options参数：
                                 作用：关闭javac中与"编译选项"相关的警告
                                 常见警告示例：
                                   warning: [options] bootstrap class path not set
                                 使用目的：
                                   - 在使用-release后，此类警告无实际意义
                                   - 保持构建日志干净，避免干扰真正的问题
                            -->
                            <arg>-Xlint:-options</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

            </plugins>

        </pluginManagement>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 所有插件只需声明，不需要再指定 version / configuration等，在父pom.xml中已定义 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

